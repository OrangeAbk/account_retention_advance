<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_move_form_inherit_retention_advance" model="ir.ui.view">
        <field name="name">account.move.form.inherit.retention.advance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">

                <field name="retention_percentage"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>

                <field name="retention_amount"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="1"/>

                <field name="advance_payment_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True, 'no_open': True}"/>

                <field name="advance_recovery_remaining"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not advance_payment_id"
                       readonly="1"/>

                <field name="advance_recovery_method"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>

                <field name="advance_recovery_percentage"
                       invisible="move_type not in ('out_invoice', 'out_refund') or advance_recovery_method != 'percentage'"/>

                <field name="advance_recovery_fixed"
                       invisible="move_type not in ('out_invoice', 'out_refund') or advance_recovery_method != 'fixed'"/>

                <field name="advance_recovery_amount"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="advance_recovery_method == 'percentage'"/>

                <field name="amount_payable_now"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="1"/>

                <field name="retention_due_date"
                       invisible="move_type != 'out_invoice'"/>
                <field name="retention_move_id"
                       invisible="move_type != 'out_invoice'"/>
                <field name="retention_split_done"/>
            </xpath>

        </field>
    </record>


</odoo>